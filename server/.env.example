# =================================================================
# JASHVI BOUTIQUE - SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Copy this file to .env and fill in your actual private credentials.
# NEVER commit the .env file or real secrets to version control.

# Application Environment & Port
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
# Local: mongodb://127.0.0.1:27017/jashvi_boutique
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jashvi_boutique?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/jashvi_boutique

# Authentication Secrets (Generate secure random 64-char strings)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_here

# Initial Admin Seeding Credentials (Used by seed script only)
ADMIN_NAME=Jashvi Boutique Admin
ADMIN_EMAIL=admin@jashviboutique.com
ADMIN_PASSWORD=ReplaceWithStrongPassword123!
ADMIN_PHONE=8050853393

# Image Storage Adapter Configuration
# Supported options: 'local' (default development adapter) or 'cloudinary'
STORAGE_MODE=local
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway Configuration (Razorpay)
# Supported options: 'mock' (default development sandbox) or 'razorpay'
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Store Contact & Information (Default values)
BOUTIQUE_NAME=Jashvi Boutique
BOUTIQUE_PHONE=8050853393
BOUTIQUE_EMAIL=contact@jashviboutique.com
BOUTIQUE_ADDRESS=#G1, Ground Floor, Bloom Residency, Victor Bishop Road, Attavara, Mangalore, Karnataka 575001
